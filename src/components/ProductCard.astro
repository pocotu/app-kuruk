---
import type { Producto } from '../lib/api';
import { codigoProducto, formatearSoles } from '../lib/formato';
import Starlink from './Starlink.astro';
import Stock from './Stock.astro';

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
---

<a href={`/productos/${producto.id}`} class="card-link flex h-full flex-col p-5">
  <div class="flex h-6 items-center justify-between gap-2">
    <span class="text-[13px] text-stone-500">
      {producto.categoria} · <span class="font-mono">{codigoProducto(producto.id)}</span>
    </span>
    {producto.compatible_starlink && <Starlink />}
  </div>

  <h2 class="mt-3 text-[17px] font-semibold leading-snug">{producto.nombre}</h2>
  {producto.oferta && <p class="mt-1 text-[14px] text-stone-600">{producto.oferta}</p>}

  <div class="mt-auto flex items-end justify-between gap-2 pt-5">
    <span class="text-xl font-semibold tabular-nums">{formatearSoles(producto.precio)}</span>
    <Stock producto={producto} />
  </div>
</a>
