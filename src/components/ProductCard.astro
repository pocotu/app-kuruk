---
import {
  calcularNivelStock,
  claseBadgeStock,
  codigoProducto,
  formatearSoles,
  type NivelStock,
} from '../lib/formato';

interface Props {
  producto: {
    id: number;
    nombre: string;
    categoria: string;
    precio: number;
    stock: number;
    compatible_starlink: boolean;
    oferta: string | null;
  };
}

const { producto } = Astro.props;
const nivel: NivelStock = calcularNivelStock(producto.stock);
const claseStock = claseBadgeStock(nivel);
---

<a
  href={`/productos/${producto.id}`}
  class="group block rounded-2xl border border-slate-200 bg-white p-4 shadow-xs transition hover:border-emerald-500 hover:shadow-md"
>
  <div class="flex items-start gap-3.5">
    <div
      class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-700"
      aria-hidden="true"
    >
      {producto.categoria === 'Celular' && (
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <rect x="7" y="2" width="10" height="20" rx="2" ry="2" />
          <line x1="12" y1="18" x2="12.01" y2="18" />
        </svg>
      )}
      {producto.categoria === 'Conectividad' && (
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" />
        </svg>
      )}
      {producto.categoria !== 'Celular' && producto.categoria !== 'Conectividad' && (
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
      )}
    </div>

    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="text-xs font-mono font-medium text-slate-500">
          {codigoProducto(producto.id)}
        </span>
        <span class="rounded-md bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">
          {producto.categoria}
        </span>
        {producto.compatible_starlink && (
          <span class="inline-flex items-center gap-1 rounded-md border border-emerald-300 bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-900">
            ● Starlink
          </span>
        )}
      </div>

      <h2 class="mt-1 text-base font-bold text-slate-900 group-hover:text-emerald-700">
        {producto.nombre}
      </h2>

      {producto.oferta && (
        <p class="mt-0.5 text-xs font-medium text-emerald-700">
          Oferta: {producto.oferta}
        </p>
      )}

      <div class="mt-3 flex items-center justify-between gap-2">
        <span class="text-lg font-extrabold text-slate-900">
          {formatearSoles(producto.precio)}
        </span>

        <span
          class:list={[
            'inline-flex items-center rounded-lg border px-2.5 py-1 text-xs font-bold',
            claseStock,
          ]}
        >
          {nivel}: {producto.stock} u.
        </span>
      </div>
    </div>
  </div>
</a>
