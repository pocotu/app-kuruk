---
import { soporte } from '../lib/soporte';

// Barra delgada de contacto, encima de la cabecera.
interface Props {
  ancho: 'max-w-5xl' | 'max-w-6xl';
}

const { ancho } = Astro.props;
---

<div class="no-print bg-black text-stone-400">
  <div class:list={['mx-auto flex h-8 items-center justify-between gap-4 px-4 text-[12px] sm:px-6', ancho]}>
    <span class="hidden text-[11px] font-semibold tracking-[0.14em] text-stone-500 sm:inline">CONTACTO</span>
    <div class="flex w-full items-center justify-between gap-5 sm:w-auto">
      <a href={soporte.whatsapp} target="_blank" rel="noopener" class="flex items-center gap-1.5 tabular-nums transition-colors hover:text-crema" aria-label={`WhatsApp ${soporte.telefono}`}>
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-5A8 8 0 1 1 21 12Z" /></svg>
        {soporte.telefono}
      </a>
      <a href={soporte.mailto} class="flex min-w-0 items-center gap-1.5 transition-colors hover:text-crema">
        <svg class="size-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 6.5h17v11h-17zM3.5 7l8.5 6.5L20.5 7" /></svg>
        <span class="truncate">{soporte.email}</span>
      </a>
    </div>
  </div>
</div>
