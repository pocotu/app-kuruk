---
import { soporte } from '../lib/soporte';
import BarraContacto from '../components/BarraContacto.astro';
import Base from './Base.astro';

interface Props {
  titulo: string;
  seccion?: 'catalogo' | 'comprobantes' | 'gestion';
}

const { titulo, seccion } = Astro.props;
const { user: usuario } = Astro.locals;

const items = [
  { id: 'catalogo', href: '/', texto: 'Catálogo', icono: 'M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6Zm0 9.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6Zm0 9.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z' },
  { id: 'comprobantes', href: '/comprobantes', texto: 'Comprobantes', icono: 'M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2Z' },
  { id: 'gestion', href: '/gestion', texto: 'Gestión', icono: 'M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75' },
];
const navegacion = items.filter((item) => item.id !== 'gestion' || usuario?.rol === 'Administrador');

const iniciales = usuario?.nombre
  .split(' ')
  .slice(0, 2)
  .map((parte) => parte[0])
  .join('');
---

<Base titulo={`${titulo} · KURUK`}>
  <header class="no-print sticky top-0 z-20 bg-noche text-crema">
    <BarraContacto ancho="max-w-5xl" />
    <div class="mx-auto flex h-16 max-w-5xl items-center gap-8 px-4 sm:px-6">
      <a href="/" class="flex shrink-0 items-center gap-3" aria-label="KURUK, ir al catálogo">
        <span class="text-[19px] font-bold tracking-tight">KURUK</span>
        <span class="hidden border-l border-white/20 pl-3 text-[11px] font-semibold tracking-[0.14em] text-stone-400 lg:block">TAMBOPATA</span>
      </a>

      {usuario && (
      <nav aria-label="Principal" class="hidden h-full items-stretch gap-6 md:flex">
        {
          navegacion.map((item) => (
            <a
              href={item.href}
              aria-current={seccion === item.id ? 'page' : undefined}
              class="relative flex items-center text-[15px] font-medium text-stone-400 transition-colors after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:bg-transparent hover:text-crema aria-[current=page]:text-crema aria-[current=page]:after:bg-accent-claro"
            >
              {item.texto}
            </a>
          ))
        }
      </nav>
      )}

      {
        usuario && (
          <div class="ml-auto flex items-center gap-3">
            <div class="hidden text-right leading-tight sm:block">
              <p class="text-[14px] font-medium">{usuario.nombre}</p>
              <p class="text-[13px] text-stone-400">{usuario.rol}</p>
            </div>
            <span class="grid size-9 place-items-center rounded-full bg-white/10 text-[13px] font-semibold sm:hidden" aria-hidden="true">
              {iniciales}
            </span>
            <a href={soporte.whatsapp} target="_blank" rel="noopener" class="btn btn-sm btn-oscuro" title={`Soporte: ${soporte.telefono} · ${soporte.email}`}>
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-5A8 8 0 1 1 21 12Z" /></svg>
              <span class="sr-only sm:not-sr-only">Soporte</span>
            </a>
            <form method="POST" action="/logout">
              <button type="submit" class="btn btn-sm btn-oscuro">Salir</button>
            </form>
          </div>
        )
      }
    </div>
  </header>

  <main class:list={['mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10', usuario && 'pb-28 md:pb-12']}>
    <slot />
  </main>

  {
    usuario && (
      <nav
        aria-label="Principal"
        class="no-print fixed inset-x-0 bottom-0 z-20 bg-noche pb-[env(safe-area-inset-bottom)] md:hidden"
      >
        <div class="flex">
          {navegacion.map((item) => (
            <a
              href={item.href}
              aria-current={seccion === item.id ? 'page' : undefined}
              class="flex h-16 flex-1 flex-col items-center justify-center gap-1 text-[13px] font-medium text-stone-400 transition-colors aria-[current=page]:text-crema"
            >
              <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icono} />
              </svg>
              {item.texto}
            </a>
          ))}
        </div>
      </nav>
    )
  }
</Base>
