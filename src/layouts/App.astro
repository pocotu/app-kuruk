---
import { actions } from 'astro:actions';
import '../styles/global.css';

interface Props {
  titulo: string;
  seccion?: 'catalogo' | 'comprobantes' | 'gestion';
}

const { titulo, seccion = 'catalogo' } = Astro.props;
const usuario = Astro.locals.user;
const esAdmin = usuario?.rol === 'Administrador';
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo} · KURUK</title>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 pb-24">
    <header class="no-print sticky top-0 z-20 bg-slate-900 text-white shadow-sm">
      <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
        <a href="/" class="flex items-center gap-2 font-bold tracking-tight text-lg">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-500 text-slate-950 font-extrabold">
            K
          </span>
          <span>KURUK</span>
          <span class="hidden sm:inline text-xs font-normal text-slate-400">
            · Mostrador Tambopata
          </span>
        </a>

        {usuario && (
          <div class="flex items-center gap-3">
            <div class="text-right text-xs leading-tight">
              <p class="font-semibold text-white">{usuario.nombre}</p>
              <p class="text-emerald-400">{usuario.rol}</p>
            </div>
            <form method="POST" action={actions.logout}>
              <button
                type="submit"
                class="min-h-[44px] rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-xs font-semibold text-slate-200 hover:bg-slate-700 active:bg-slate-600"
              >
                Salir
              </button>
            </form>
          </div>
        )}
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-4 py-5">
      <slot />
    </main>

    {usuario && (
      <nav
        aria-label="Navegación principal"
        class="no-print fixed bottom-0 left-0 right-0 z-30 border-t border-slate-200 bg-white shadow-lg"
      >
        <div
          class:list={[
            'mx-auto grid max-w-3xl',
            esAdmin ? 'grid-cols-3' : 'grid-cols-2',
          ]}
        >
          <a
            href="/"
            class:list={[
              'flex min-h-[56px] flex-col items-center justify-center gap-0.5 px-2 py-2 text-xs font-semibold transition-colors',
              seccion === 'catalogo'
                ? 'text-emerald-700 bg-emerald-50/70 border-t-2 border-emerald-600'
                : 'text-slate-600 hover:text-slate-900',
            ]}
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <span>Catálogo</span>
          </a>

          <a
            href="/comprobantes"
            class:list={[
              'flex min-h-[56px] flex-col items-center justify-center gap-0.5 px-2 py-2 text-xs font-semibold transition-colors',
              seccion === 'comprobantes'
                ? 'text-emerald-700 bg-emerald-50/70 border-t-2 border-emerald-600'
                : 'text-slate-600 hover:text-slate-900',
            ]}
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Comprobantes</span>
          </a>

          {esAdmin && (
            <a
              href="/gestion"
              class:list={[
                'flex min-h-[56px] flex-col items-center justify-center gap-0.5 px-2 py-2 text-xs font-semibold transition-colors',
                seccion === 'gestion'
                  ? 'text-emerald-700 bg-emerald-50/70 border-t-2 border-emerald-600'
                  : 'text-slate-600 hover:text-slate-900',
              ]}
            >
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>Gestión</span>
            </a>
          )}
        </div>
      </nav>
    )}
  </body>
</html>
