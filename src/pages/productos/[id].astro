---
import Cabecera from '../../components/Cabecera.astro';
import Starlink from '../../components/Starlink.astro';
import Stock from '../../components/Stock.astro';
import App from '../../layouts/App.astro';
import { leer, type Producto } from '../../lib/api';
import { codigoProducto, estadoStock, formatearSoles } from '../../lib/formato';

const producto = await leer<Producto>(Astro.cookies, `/productos/${Astro.params.id}`);
if (!producto) {
  return Astro.redirect('/');
}

const esAdmin = Astro.locals.user?.rol === 'Administrador';

const fichaWhatsApp = [
  `*${producto.nombre}* (${codigoProducto(producto.id)})`,
  `Precio: ${formatearSoles(producto.precio)}`,
  `Stock: ${estadoStock(producto).texto}`,
  `Compatible con Starlink: ${producto.compatible_starlink ? 'Sí' : 'No'}`,
  producto.oferta && `Oferta: ${producto.oferta}`,
  'KURUK · Tambopata',
]
  .filter(Boolean)
  .join('\n');

const datos = [
  { etiqueta: 'Categoría', valor: producto.categoria },
  { etiqueta: 'Código', valor: codigoProducto(producto.id) },
  { etiqueta: 'Oferta vigente', valor: producto.oferta ?? 'Sin oferta' },
  { etiqueta: 'Starlink', valor: producto.compatible_starlink ? 'Compatible' : 'No compatible' },
];
---

<App titulo={producto.nombre} seccion="catalogo">
  <Cabecera titulo={producto.nombre} volver={{ href: '/', texto: 'Catálogo' }} />

  <div class="grid gap-4 lg:grid-cols-[1fr_320px]">
    <section class="card p-5 sm:p-6" aria-label="Ficha técnica">
      <dl class="divide-y divide-stone-200">
        {
          datos.map((d) => (
            <div class="grid gap-1 py-3.5 first:pt-0 last:pb-0 sm:grid-cols-[160px_1fr] sm:gap-4">
              <dt class="text-[14px] text-stone-500">{d.etiqueta}</dt>
              <dd class="text-[15px]">{d.valor}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <aside class="card flex flex-col gap-5 p-5 sm:p-6">
      <div class="flex flex-wrap items-center gap-2">
        {producto.compatible_starlink && <Starlink />}
        <Stock producto={producto} />
      </div>
      <p class="text-3xl font-semibold tabular-nums tracking-tight">{formatearSoles(producto.precio)}</p>

      <div class="flex flex-col gap-2">
        {producto.stock > 0 && <a href={`/comprobantes/nuevo?producto_id=${producto.id}`} class="btn btn-primary">Vender este equipo</a>}
        <button type="button" class="btn btn-secondary" data-copiar={fichaWhatsApp}>
          <span data-texto>Copiar ficha para WhatsApp</span>
        </button>
        {esAdmin && <a href={`/gestion/productos/${producto.id}`} class="btn btn-secondary">Editar producto</a>}
      </div>
    </aside>
  </div>

  <script>
    // Copia la ficha y confirma en el mismo botón durante 2 segundos.
    document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((boton) => {
      const etiqueta = boton.querySelector<HTMLElement>('[data-texto]');
      const original = etiqueta?.textContent ?? '';
      boton.addEventListener('click', async () => {
        await navigator.clipboard.writeText(boton.dataset.copiar ?? '');
        if (etiqueta) {
          etiqueta.textContent = 'Ficha copiada';
          setTimeout(() => (etiqueta.textContent = original), 2000);
        }
      });
    });
  </script>
</App>
