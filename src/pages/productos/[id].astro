---
import { db, eq, Productos } from 'astro:db';
import App from '../../layouts/App.astro';
import {
  calcularNivelStock,
  claseBadgeStock,
  codigoProducto,
  formatearSoles,
  type NivelStock,
} from '../../lib/formato';

const idParam = Number(Astro.params.id);
if (!Number.isInteger(idParam) || idParam <= 0) {
  return Astro.redirect('/');
}

const filas = await db.select().from(Productos).where(eq(Productos.id, idParam));
const producto = filas[0];

if (!producto) {
  return Astro.redirect('/');
}

const nivel: NivelStock = calcularNivelStock(producto.stock);
const esAdmin = Astro.locals.user?.rol === 'Administrador';
const claseStock = claseBadgeStock(nivel);

const textoWhatsApp = [
  `*KURUK Tambopata*`,
  `Equipo: *${producto.nombre}* (${codigoProducto(producto.id)})`,
  `Precio: *${formatearSoles(producto.precio)}*`,
  `Stock disponible: ${producto.stock} u. (${nivel})`,
  `Compatible con Starlink: ${producto.compatible_starlink ? 'Sí' : 'No'}`,
  producto.oferta ? `Oferta vigente: ${producto.oferta}` : null,
]
  .filter(Boolean)
  .join('\n');
---

<App titulo={producto.nombre} seccion="catalogo">
  <div class="mb-4">
    <a
      href="/"
      class="inline-flex min-h-[44px] items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-slate-900"
    >
      ← Volver al catálogo
    </a>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-md bg-slate-100 px-2.5 py-1 font-mono text-xs font-semibold text-slate-700">
        {codigoProducto(producto.id)}
      </span>
      <span class="rounded-md bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">
        {producto.categoria}
      </span>
      {producto.compatible_starlink ? (
        <span class="inline-flex items-center gap-1 rounded-md border border-emerald-300 bg-emerald-100 px-2.5 py-1 text-xs font-bold text-emerald-900">
          ● Compatible con Starlink
        </span>
      ) : (
        <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">
          Sin compatibilidad Starlink
        </span>
      )}
    </div>

    <h1 class="mt-3 text-2xl font-extrabold text-slate-900">{producto.nombre}</h1>

    <div class="mt-4 flex flex-wrap items-baseline justify-between gap-3 border-y border-slate-100 py-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
          Precio de venta
        </p>
        <p class="text-3xl font-extrabold text-slate-900">
          {formatearSoles(producto.precio)}
        </p>
      </div>

      <div class="text-right">
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
          Disponibilidad
        </p>
        <span
          class:list={[
            'mt-1 inline-flex items-center rounded-xl border px-3 py-1.5 text-xs font-bold',
            claseStock,
          ]}
        >
          {nivel} · {producto.stock} unidades
        </span>
      </div>
    </div>

    <dl class="mt-4 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
      <div class="rounded-xl bg-slate-50 p-3">
        <dt class="text-xs font-semibold text-slate-500">Oferta vigente</dt>
        <dd class="mt-0.5 font-bold text-emerald-800">
          {producto.oferta || 'Sin oferta especial'}
        </dd>
      </div>
      <div class="rounded-xl bg-slate-50 p-3">
        <dt class="text-xs font-semibold text-slate-500">Red satelital Starlink</dt>
        <dd class="mt-0.5 font-semibold text-slate-800">
          {producto.compatible_starlink
            ? 'Verificado para zonas rurales de Madre de Dios'
            : 'Uso estándar en red móvil / Wi-Fi'}
        </dd>
      </div>
    </dl>

    <div class="mt-6 flex flex-col gap-2.5 sm:flex-row">
      {producto.stock > 0 && (
        <a
          href={`/comprobantes/nuevo?producto_id=${producto.id}`}
          class="inline-flex min-h-[48px] flex-1 items-center justify-center rounded-xl bg-emerald-600 px-4 py-3 text-center text-sm font-bold text-white shadow-xs hover:bg-emerald-700"
        >
          Vender este equipo
        </a>
      )}

      <button
        id="btn-copiar-wa"
        type="button"
        data-wa-text={textoWhatsApp}
        class="inline-flex min-h-[48px] flex-1 items-center justify-center gap-2 rounded-xl border border-emerald-600 bg-emerald-50 px-4 py-3 text-sm font-bold text-emerald-900 hover:bg-emerald-100"
      >
        <span>Copiar para WhatsApp</span>
      </button>

      {esAdmin && (
        <a
          href={`/gestion/productos/${producto.id}`}
          class="inline-flex min-h-[48px] items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100"
        >
          Editar producto
        </a>
      )}
    </div>

    <p
      id="msg-copiado"
      role="status"
      class="mt-3 hidden rounded-xl border border-emerald-200 bg-emerald-50 p-2.5 text-center text-xs font-bold text-emerald-800"
    >
      Ficha copiada al portapapeles. Lista para pegar en WhatsApp.
    </p>
  </div>

  <script>
    const boton = document.querySelector<HTMLButtonElement>('#btn-copiar-wa');
    const aviso = document.querySelector<HTMLElement>('#msg-copiado');

    if (boton) {
      boton.addEventListener('click', async function () {
        const texto = boton.dataset.waText ?? '';
        if (!texto) {
          return;
        }
        await navigator.clipboard.writeText(texto);
        if (aviso) {
          aviso.classList.remove('hidden');
        }
      });
    }
  </script>
</App>
