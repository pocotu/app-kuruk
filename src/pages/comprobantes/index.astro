---
import { Comprobantes, db, desc, eq, Productos, Usuarios } from 'astro:db';
import App from '../../layouts/App.astro';
import {
  calcularMonto,
  claseBadgeEstado,
  codigoComprobante,
  formatearFecha,
  formatearSoles,
} from '../../lib/formato';

const dniFiltro = (Astro.url.searchParams.get('dni') ?? '').trim();

const filas = await db
  .select({
    comprobante: Comprobantes,
    producto: Productos,
    vendedor: Usuarios,
  })
  .from(Comprobantes)
  .innerJoin(Productos, eq(Comprobantes.producto_id, Productos.id))
  .innerJoin(Usuarios, eq(Comprobantes.vendedor_id, Usuarios.id))
  .orderBy(desc(Comprobantes.id));

const comprobantesFiltrados = filas.filter(function (item) {
  if (!dniFiltro) {
    return true;
  }
  const termino = dniFiltro.toLowerCase();
  return (
    item.comprobante.dni_ruc.includes(termino) ||
    item.comprobante.nombre_cliente.toLowerCase().includes(termino)
  );
});
---

<App titulo="Comprobantes" seccion="comprobantes">
  <div class="mb-4 flex items-center justify-between gap-2">
    <div>
      <h1 class="text-xl font-bold text-slate-900">Comprobantes de venta</h1>
      <p class="text-xs text-slate-600">
        Busca por DNI, RUC o cliente para garantías y seguimiento
      </p>
    </div>
    <a
      href="/comprobantes/nuevo"
      class="inline-flex min-h-[44px] items-center rounded-xl bg-emerald-600 px-3.5 py-2 text-xs font-bold text-white shadow-xs hover:bg-emerald-700"
    >
      + Nuevo comprobante
    </a>
  </div>

  <form method="GET" action="/comprobantes" class="mb-5 flex gap-2">
    <input
      type="search"
      name="dni"
      value={dniFiltro}
      placeholder="Buscar por DNI/RUC o nombre del cliente..."
      aria-label="Buscar por DNI o RUC"
      class="min-h-[44px] flex-1 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/20"
    />
    <button
      type="submit"
      class="min-h-[44px] rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800"
    >
      Buscar
    </button>
    {dniFiltro && (
      <a
        href="/comprobantes"
        class="inline-flex min-h-[44px] items-center rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100"
      >
        Limpiar
      </a>
    )}
  </form>

  {comprobantesFiltrados.length === 0 ? (
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center">
      <p class="text-sm font-semibold text-slate-700">
        No se encontraron comprobantes para esa búsqueda.
      </p>
    </div>
  ) : (
    <div class="space-y-3">
      {comprobantesFiltrados.map(({ comprobante, producto, vendedor }) => {
        const monto = calcularMonto(comprobante.precio_unitario, comprobante.cantidad);
        return (
          <a
            href={`/comprobantes/${comprobante.id}`}
            class="block rounded-2xl border border-slate-200 bg-white p-4 shadow-xs transition hover:border-emerald-500 hover:shadow-md"
          >
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs font-bold text-slate-600">
                  {codigoComprobante(comprobante.id)}
                </span>
                <span class="text-xs text-slate-400">·</span>
                <span class="text-xs text-slate-500">
                  {formatearFecha(comprobante.fecha)}
                </span>
              </div>

              <span
                class:list={[
                  'inline-flex items-center rounded-lg border px-2.5 py-0.5 text-xs font-bold',
                  claseBadgeEstado(comprobante.estado),
                ]}
              >
                {comprobante.estado}
              </span>
            </div>

            <div class="mt-2 flex items-baseline justify-between gap-2">
              <div>
                <h2 class="text-base font-bold text-slate-900">
                  {comprobante.nombre_cliente}
                </h2>
                <p class="text-xs text-slate-600">
                  DNI/RUC: <span class="font-mono font-semibold">{comprobante.dni_ruc}</span>
                </p>
              </div>
              <p class="text-lg font-extrabold text-slate-900">
                {formatearSoles(monto)}
              </p>
            </div>

            <div class="mt-2 flex flex-wrap items-center justify-between gap-2 border-t border-slate-100 pt-2 text-xs text-slate-600">
              <span>
                {producto.nombre} × {comprobante.cantidad}
              </span>
              <span>Vendedor: {vendedor.nombre}</span>
            </div>
          </a>
        );
      })}
    </div>
  )}
</App>
