---
import Buscador from '../../components/Buscador.astro';
import Cabecera from '../../components/Cabecera.astro';
import Vacio from '../../components/Vacio.astro';
import App from '../../layouts/App.astro';
import { leer, type Comprobante } from '../../lib/api';
import { claseBadgeEstado, codigoComprobante, formatearFecha, formatearSoles } from '../../lib/formato';

const busqueda = (Astro.url.searchParams.get('dni') ?? '').trim();
const comprobantes =
  (await leer<Comprobante[]>(Astro.cookies, `/comprobantes?${new URLSearchParams({ q: busqueda })}`)) ?? [];
---

<App titulo="Comprobantes" seccion="comprobantes">
  <Cabecera titulo="Comprobantes">
    <a href="/comprobantes/nuevo" class="btn btn-primary">Nuevo comprobante</a>
  </Cabecera>

  <Buscador action="/comprobantes" name="dni" value={busqueda} placeholder="DNI, RUC o nombre del cliente" etiqueta="Buscar comprobante" class="mb-6" />

  {
    comprobantes.length === 0 ? (
      <Vacio mensaje={busqueda ? `No hay comprobantes para “${busqueda}”.` : 'Aún no hay comprobantes.'}>
        {busqueda && <a href="/comprobantes" class="btn btn-secondary">Ver todos</a>}
      </Vacio>
    ) : (
      <ul class="card divide-y divide-stone-200 overflow-hidden">
        {comprobantes.map((c) => (
          <li>
            <a href={`/comprobantes/${c.id}`} class="fila">
              <div class="min-w-0 flex-1">
                <p class="truncate text-[15px] font-medium">{c.nombre_cliente}</p>
                <p class="mt-0.5 truncate text-[13px] text-stone-500">
                  <span class="font-mono">{codigoComprobante(c.id)}</span> · {formatearFecha(c.fecha)} · {c.producto.nombre} × {c.cantidad}
                </p>
              </div>
              <div class="flex shrink-0 flex-col items-end gap-1">
                <span class="text-[15px] font-semibold tabular-nums">{formatearSoles(c.monto)}</span>
                <span class:list={['badge', claseBadgeEstado(c.estado)]}>{c.estado}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</App>
