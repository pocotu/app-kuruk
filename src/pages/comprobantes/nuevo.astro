---
import Cabecera from '../../components/Cabecera.astro';
import FormComprobante from '../../components/FormComprobante.astro';
import App from '../../layouts/App.astro';
import { api, avisar, leer, leerFormulario, type Producto } from '../../lib/api';

let errores: Record<string, string> = {};
let errorGeneral: string | null = null;
let valores: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const datos = await leerFormulario(Astro.request);
  const r = await api<{ id: number }>(Astro.cookies, 'POST', '/comprobantes', datos);
  if (r.ok) {
    avisar(Astro.cookies, 'Comprobante registrado como pendiente.');
    return Astro.redirect(`/comprobantes/${r.data.id}`);
  }
  errores = r.campos;
  errorGeneral = r.general;
  valores = datos;
}

const productos = (await leer<Producto[]>(Astro.cookies, '/productos')) ?? [];
---

<App titulo="Nuevo comprobante" seccion="comprobantes">
  <div class="mx-auto max-w-2xl">
    <Cabecera
      titulo="Nuevo comprobante"
     
      volver={{ href: '/comprobantes', texto: 'Comprobantes' }}
    />

    <FormComprobante
      productos={productos}
      valores={{
        dni_ruc: valores.dni_ruc ?? '',
        nombre_cliente: valores.nombre_cliente ?? '',
        producto_id: valores.producto_id ?? Astro.url.searchParams.get('producto_id') ?? '',
        cantidad: valores.cantidad ?? '1',
      }}
      errores={errores}
      error={errorGeneral}
      boton="Guardar comprobante"
      cancelar="/comprobantes"
    />
  </div>
</App>
