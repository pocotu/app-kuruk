---
import Aviso from '../../components/Aviso.astro';
import Cabecera from '../../components/Cabecera.astro';
import FormComprobante from '../../components/FormComprobante.astro';
import Stock from '../../components/Stock.astro';
import App from '../../layouts/App.astro';
import { api, avisar, leer, leerFormulario, type ComprobanteDetalle, type Producto } from '../../lib/api';
import { claseBadgeEstado, codigoComprobante, codigoProducto, formatearFecha, formatearSoles } from '../../lib/formato';

const ruta = `/comprobantes/${Astro.params.id}`;
const exitoPorAccion = {
  editar: 'Cambios guardados.',
  emitir: 'Comprobante emitido. El stock ya se descontó.',
  anular: 'Comprobante anulado.',
} as const;

let errores: Record<string, string> = {};
let errorGeneral: string | null = null;
let valores: Record<string, string> | null = null;

if (Astro.request.method === 'POST') {
  const { accion, ...datos } = await leerFormulario(Astro.request);
  if (accion === 'editar' || accion === 'emitir' || accion === 'anular') {
    const r =
      accion === 'editar'
        ? await api(Astro.cookies, 'PATCH', ruta, datos)
        : await api(Astro.cookies, 'POST', `${ruta}/${accion}`);
    if (r.ok) {
      avisar(Astro.cookies, exitoPorAccion[accion]);
      return Astro.redirect(ruta);
    }
    errores = r.campos;
    errorGeneral = r.general;
    valores = accion === 'editar' ? datos : null;
  }
}

// Si se va a editar, el comprobante y la lista de productos se piden a la vez.
const quiereEditar = Astro.url.searchParams.get('editar') === '1' || valores !== null;
const [comprobante, listaProductos] = await Promise.all([
  leer<ComprobanteDetalle>(Astro.cookies, ruta),
  quiereEditar ? leer<Producto[]>(Astro.cookies, '/productos') : null,
]);
if (!comprobante) {
  return Astro.redirect('/comprobantes');
}

const { producto, vendedor } = comprobante;
const editando = quiereEditar && comprobante.puede_editar;
const sinStock = comprobante.estado === 'Pendiente' && producto.stock < comprobante.cantidad;

const datos = [
  { etiqueta: 'Cliente', valor: comprobante.nombre_cliente },
  { etiqueta: 'DNI / RUC', valor: comprobante.dni_ruc, mono: true },
  { etiqueta: 'Fecha', valor: formatearFecha(comprobante.fecha) },
  { etiqueta: 'Vendedor', valor: vendedor.nombre },
];
---

<App titulo={codigoComprobante(comprobante.id)} seccion="comprobantes">
  <div class="mx-auto max-w-2xl">
    <Cabecera titulo="Detalle del comprobante" volver={{ href: '/comprobantes', texto: 'Comprobantes' }} />

    <div class="mb-4 space-y-3 empty:hidden">
      {errorGeneral && !editando && <Aviso tipo="error">{errorGeneral}</Aviso>}
      {sinStock && <Aviso tipo="aviso">No se puede emitir: hay {producto.stock} en stock y el comprobante pide {comprobante.cantidad}.</Aviso>}
    </div>

    <article class="card p-5 sm:p-6">
      <header class="flex items-start justify-between gap-4 border-b border-stone-200 pb-5">
        <div>
          <img src="/assets/KURUK_logo.svg" alt="KURUK" width="1482" height="462" class="h-9 w-auto" />
          <p class="mt-1 text-[13px] text-stone-500">Smartphones y Starlink · Tambopata</p>
          <p class="mt-3 font-mono text-lg font-medium">{codigoComprobante(comprobante.id)}</p>
        </div>
        <span class:list={['badge', claseBadgeEstado(comprobante.estado)]}>{comprobante.estado}</span>
      </header>

      <dl class="grid grid-cols-2 gap-x-6 gap-y-4 py-5">
        {
          datos.map((d) => (
            <div>
              <dt class="text-[13px] text-stone-500">{d.etiqueta}</dt>
              <dd class:list={['mt-0.5 text-[15px]', d.mono && 'font-mono']}>{d.valor}</dd>
            </div>
          ))
        }
      </dl>

      <div class="border-t border-stone-200 py-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-[15px] font-medium">{producto.nombre}</p>
            <p class="mt-0.5 text-[13px] text-stone-500">
              <span class="font-mono">{codigoProducto(producto.id)}</span> · {comprobante.cantidad} × {formatearSoles(comprobante.precio_unitario)}
            </p>
          </div>
          <span class="text-[15px] tabular-nums">{formatearSoles(comprobante.monto)}</span>
        </div>
        <p class="no-print mt-3 flex items-center gap-2 text-[13px] text-stone-500">Stock actual <Stock producto={producto} /></p>
      </div>

      <div class="flex items-baseline justify-between border-t border-stone-200 pt-5">
        <span class="text-[15px] text-stone-600">Total</span>
        <span class="text-2xl font-semibold tabular-nums tracking-tight">{formatearSoles(comprobante.monto)}</span>
      </div>
    </article>

    <div class="no-print mt-4 flex flex-col gap-2 sm:flex-row-reverse sm:justify-start">
      {comprobante.puede_emitir && (
        <form method="POST" action={ruta}>
          <input type="hidden" name="accion" value="emitir" />
          <button type="submit" class="btn btn-primary w-full">Emitir comprobante</button>
        </form>
      )}
      {comprobante.puede_editar && !editando && (
        <a href={`${ruta}?editar=1`} class="btn btn-secondary">Editar datos</a>
      )}
      {comprobante.puede_anular && (
        <form
          method="POST"
          action={ruta}
          class="sm:mr-auto"
          data-confirmar={comprobante.estado === 'Emitido' ? '¿Anular el comprobante y devolver el stock?' : '¿Anular el comprobante?'}
        >
          <input type="hidden" name="accion" value="anular" />
          <button type="submit" class="btn btn-danger w-full">Anular</button>
        </form>
      )}
      <button type="button" class="btn btn-secondary" data-imprimir>Imprimir</button>
    </div>

    {
      editando && (
        <section class="no-print mt-8" aria-labelledby="titulo-editar">
          <h2 id="titulo-editar" class="mb-3 text-lg font-semibold">Editar comprobante</h2>
          <FormComprobante
            productos={listaProductos ?? []}
            valores={{
              dni_ruc: valores?.dni_ruc ?? comprobante.dni_ruc,
              nombre_cliente: valores?.nombre_cliente ?? comprobante.nombre_cliente,
              producto_id: valores?.producto_id ?? String(producto.id),
              cantidad: valores?.cantidad ?? String(comprobante.cantidad),
            }}
            errores={errores}
            error={errorGeneral}
            boton="Guardar cambios"
            cancelar={ruta}
            action={ruta}
            accion="editar"
          />
        </section>
      )
    }
  </div>

  <script>
    document.querySelector('[data-imprimir]')?.addEventListener('click', () => window.print());
  </script>
</App>
