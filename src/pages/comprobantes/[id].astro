---
import { actions, isInputError } from 'astro:actions';
import { Comprobantes, db, eq, Productos, Usuarios } from 'astro:db';
import App from '../../layouts/App.astro';
import {
  calcularMonto,
  calcularNivelStock,
  claseBadgeEstado,
  codigoComprobante,
  codigoProducto,
  formatearFecha,
  formatearSoles,
} from '../../lib/formato';

const idParam = Number(Astro.params.id);
if (!Number.isInteger(idParam) || idParam <= 0) {
  return Astro.redirect('/comprobantes');
}

const resEditar = Astro.getActionResult(actions.editarComprobante);
if (resEditar && !resEditar.error) {
  return Astro.redirect(`/comprobantes/${idParam}?mensaje=editado`);
}

const resEmitir = Astro.getActionResult(actions.emitirComprobante);
if (resEmitir && !resEmitir.error) {
  return Astro.redirect(`/comprobantes/${idParam}?mensaje=emitido`);
}

const resAnular = Astro.getActionResult(actions.anularComprobante);
if (resAnular && !resAnular.error) {
  return Astro.redirect(`/comprobantes/${idParam}?mensaje=anulado`);
}

const filas = await db
  .select({
    comprobante: Comprobantes,
    producto: Productos,
    vendedor: Usuarios,
  })
  .from(Comprobantes)
  .innerJoin(Productos, eq(Comprobantes.producto_id, Productos.id))
  .innerJoin(Usuarios, eq(Comprobantes.vendedor_id, Usuarios.id))
  .where(eq(Comprobantes.id, idParam));

const registro = filas[0];
if (!registro) {
  return Astro.redirect('/comprobantes');
}

const { comprobante, producto, vendedor } = registro;
const usuarioActual = Astro.locals.user;
const esAdmin = usuarioActual?.rol === 'Administrador';
const esPropio = usuarioActual?.id === comprobante.vendedor_id;

const puedeEditar = comprobante.estado === 'Pendiente' && (esAdmin || esPropio);
const puedeEmitir =
  comprobante.estado === 'Pendiente' && producto.stock >= comprobante.cantidad;
const puedeAnular = esAdmin && comprobante.estado !== 'Anulado';

const montoTotal = calcularMonto(comprobante.precio_unitario, comprobante.cantidad);
const nivelStock = calcularNivelStock(producto.stock);

const todosProductos = puedeEditar ? await db.select().from(Productos) : [];

const erroresEdicion =
  resEditar?.error && isInputError(resEditar.error) ? resEditar.error.fields : {};

const errorGeneral =
  (resEditar?.error && !isInputError(resEditar.error) ? resEditar.error.message : null) ??
  resEmitir?.error?.message ??
  resAnular?.error?.message ??
  null;

const mensajeParam = Astro.url.searchParams.get('mensaje');
const modoEditar = Astro.url.searchParams.get('editar') === '1' || Boolean(resEditar?.error);

let textoExito: string | null = null;
if (mensajeParam === 'creado') {
  textoExito = 'Comprobante registrado correctamente en estado Pendiente.';
} else if (mensajeParam === 'editado') {
  textoExito = 'Los cambios del comprobante se guardaron correctamente.';
} else if (mensajeParam === 'emitido') {
  textoExito = 'Comprobante emitido y stock descontado correctamente.';
} else if (mensajeParam === 'anulado') {
  textoExito = 'El comprobante fue anulado.';
}

const claseEstado = claseBadgeEstado(comprobante.estado);
---

<App titulo={codigoComprobante(comprobante.id)} seccion="comprobantes">
  <div class="no-print mb-4 flex items-center justify-between">
    <a
      href="/comprobantes"
      class="inline-flex min-h-[44px] items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-slate-900"
    >
      ← Volver a comprobantes
    </a>

    <button
      id="btn-imprimir"
      type="button"
      class="inline-flex min-h-[44px] items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-bold text-slate-800 hover:bg-slate-100"
    >
      Imprimir comprobante
    </button>
  </div>

  {textoExito && (
    <div
      role="status"
      class="no-print mb-4 rounded-xl border border-emerald-300 bg-emerald-50 p-3 text-sm font-semibold text-emerald-900"
    >
      {textoExito}
    </div>
  )}

  {errorGeneral && (
    <div
      role="alert"
      class="no-print mb-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm font-semibold text-red-800"
    >
      {errorGeneral}
    </div>
  )}

  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
    <div class="flex flex-wrap items-start justify-between gap-2 border-b border-slate-200 pb-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-700">
          KURUK · Smartphones y Starlink · Tambopata
        </p>
        <h1 class="mt-1 font-mono text-2xl font-extrabold text-slate-900">
          {codigoComprobante(comprobante.id)}
        </h1>
        <p class="text-xs text-slate-500">
          Fecha de emisión: {formatearFecha(comprobante.fecha)}
        </p>
      </div>

      <span
        class:list={[
          'inline-flex items-center rounded-xl border px-3 py-1 text-xs font-bold',
          claseEstado,
        ]}
      >
        Estado: {comprobante.estado}
      </span>
    </div>

    <dl class="mt-4 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
      <div class="rounded-xl bg-slate-50 p-3">
        <dt class="text-xs font-semibold text-slate-500">Cliente</dt>
        <dd class="mt-0.5 font-bold text-slate-900">{comprobante.nombre_cliente}</dd>
      </div>

      <div class="rounded-xl bg-slate-50 p-3">
        <dt class="text-xs font-semibold text-slate-500">DNI / RUC</dt>
        <dd class="mt-0.5 font-mono font-bold text-slate-900">{comprobante.dni_ruc}</dd>
      </div>

      <div class="rounded-xl bg-slate-50 p-3">
        <dt class="text-xs font-semibold text-slate-500">Vendedor responsable</dt>
        <dd class="mt-0.5 font-semibold text-slate-800">
          {vendedor.nombre} ({vendedor.email})
        </dd>
      </div>

      <div class="rounded-xl bg-slate-50 p-3">
        <dt class="text-xs font-semibold text-slate-500">Stock actual del producto</dt>
        <dd class="mt-0.5 font-semibold text-slate-800">
          {producto.stock} unidades ({nivelStock})
        </dd>
      </div>
    </dl>

    <div class="mt-4 rounded-xl border border-slate-200 p-4">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <div>
          <span class="font-mono text-xs font-semibold text-slate-500">
            {codigoProducto(producto.id)}
          </span>
          <h2 class="text-base font-bold text-slate-900">{producto.nombre}</h2>
          <p class="text-xs text-slate-600">
            Cantidad: <strong>{comprobante.cantidad}</strong> × Precio unitario:{' '}
            <strong>{formatearSoles(comprobante.precio_unitario)}</strong>
          </p>
        </div>

        <div class="text-right">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
            Monto total calculado
          </p>
          <p class="text-2xl font-extrabold text-slate-900">
            {formatearSoles(montoTotal)}
          </p>
        </div>
      </div>
    </div>

    {comprobante.estado === 'Pendiente' && producto.stock < comprobante.cantidad && (
      <p class="no-print mt-3 rounded-xl border border-red-200 bg-red-50 p-3 text-xs font-semibold text-red-800">
        No se puede emitir este comprobante porque el stock actual ({producto.stock} u.) es
        menor a la cantidad solicitada ({comprobante.cantidad} u.).
      </p>
    )}

    <div class="no-print mt-5 flex flex-wrap gap-2.5">
      {puedeEmitir && (
        <form method="POST" action={actions.emitirComprobante} class="flex-1">
          <input type="hidden" name="id" value={comprobante.id} />
          <button
            type="submit"
            class="min-h-[48px] w-full rounded-xl bg-emerald-600 px-4 py-3 text-sm font-bold text-white shadow-xs hover:bg-emerald-700"
          >
            Emitir comprobante (descuenta {comprobante.cantidad} de stock)
          </button>
        </form>
      )}

      {puedeEditar && !modoEditar && (
        <a
          href={`/comprobantes/${comprobante.id}?editar=1`}
          class="inline-flex min-h-[48px] items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800 hover:bg-slate-100"
        >
          Editar datos
        </a>
      )}

      {puedeAnular && (
        <form method="POST" action={actions.anularComprobante}>
          <input type="hidden" name="id" value={comprobante.id} />
          <button
            type="submit"
            class="min-h-[48px] rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm font-bold text-red-800 hover:bg-red-100"
          >
            {comprobante.estado === 'Emitido'
              ? 'Anular y devolver stock'
              : 'Anular comprobante'}
          </button>
        </form>
      )}
    </div>
  </div>

  {puedeEditar && modoEditar && (
    <div class="no-print mt-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
      <h2 class="text-lg font-bold text-slate-900">Editar comprobante pendiente</h2>
      <p class="mt-0.5 text-xs text-slate-600">
        Puedes corregir cliente, DNI/RUC, producto o cantidad antes de emitir.
      </p>

      <form method="POST" action={actions.editarComprobante} novalidate class="mt-4 space-y-4">
        <input type="hidden" name="id" value={comprobante.id} />

        <div>
          <label for="edit_dni_ruc" class="block text-sm font-semibold text-slate-700">
            DNI (8 dígitos) o RUC (11 dígitos) <span class="text-red-600">*</span>
          </label>
          <input
            id="edit_dni_ruc"
            name="dni_ruc"
            type="text"
            inputmode="numeric"
            required
            value={comprobante.dni_ruc}
            class="mt-1 block min-h-[44px] w-full rounded-xl border border-slate-300 px-3.5 py-2.5 font-mono text-sm text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/20"
          />
          {erroresEdicion.dni_ruc && (
            <p class="mt-1 text-xs font-semibold text-red-600">
              {erroresEdicion.dni_ruc[0]}
            </p>
          )}
        </div>

        <div>
          <label for="edit_nombre_cliente" class="block text-sm font-semibold text-slate-700">
            Nombre del cliente <span class="text-red-600">*</span>
          </label>
          <input
            id="edit_nombre_cliente"
            name="nombre_cliente"
            type="text"
            required
            value={comprobante.nombre_cliente}
            class="mt-1 block min-h-[44px] w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/20"
          />
          {erroresEdicion.nombre_cliente && (
            <p class="mt-1 text-xs font-semibold text-red-600">
              {erroresEdicion.nombre_cliente[0]}
            </p>
          )}
        </div>

        <div>
          <label for="edit_producto_id" class="block text-sm font-semibold text-slate-700">
            Producto <span class="text-red-600">*</span>
          </label>
          <select
            id="edit_producto_id"
            name="producto_id"
            required
            class="mt-1 block min-h-[44px] w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/20"
          >
            {todosProductos.map((p) => (
              <option value={p.id} selected={p.id === comprobante.producto_id}>
                {codigoProducto(p.id)} · {p.nombre} — {formatearSoles(p.precio)} (Stock: {p.stock})
              </option>
            ))}
          </select>
          {erroresEdicion.producto_id && (
            <p class="mt-1 text-xs font-semibold text-red-600">
              {erroresEdicion.producto_id[0]}
            </p>
          )}
        </div>

        <div>
          <label for="edit_cantidad" class="block text-sm font-semibold text-slate-700">
            Cantidad <span class="text-red-600">*</span>
          </label>
          <input
            id="edit_cantidad"
            name="cantidad"
            type="number"
            min="1"
            step="1"
            required
            value={comprobante.cantidad}
            class="mt-1 block min-h-[44px] w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/20"
          />
          {erroresEdicion.cantidad && (
            <p class="mt-1 text-xs font-semibold text-red-600">
              {erroresEdicion.cantidad[0]}
            </p>
          )}
        </div>

        <div class="flex gap-2.5 pt-2">
          <button
            type="submit"
            class="min-h-[48px] flex-1 rounded-xl bg-slate-900 px-4 py-3 text-sm font-bold text-white hover:bg-slate-800"
          >
            Guardar cambios
          </button>
          <a
            href={`/comprobantes/${comprobante.id}`}
            class="inline-flex min-h-[48px] items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-100"
          >
            Cancelar
          </a>
        </div>
      </form>
    </div>
  )}

  <script>
    const btnImprimir = document.querySelector<HTMLButtonElement>('#btn-imprimir');
    btnImprimir?.addEventListener('click', function () {
      window.print();
    });
  </script>
</App>
