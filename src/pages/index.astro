---
import { db, Productos } from 'astro:db';
import ProductCard from '../components/ProductCard.astro';
import App from '../layouts/App.astro';

const q = (Astro.url.searchParams.get('q') ?? '').trim();
const chip = Astro.url.searchParams.get('chip') ?? 'Todos';
const errorParam = Astro.url.searchParams.get('error');

const todosProductos = await db.select().from(Productos);

const productosFiltrados = todosProductos.filter(function (p) {
  if (chip === 'Starlink' && !p.compatible_starlink) {
    return false;
  }
  if (
    (chip === 'Celular' || chip === 'Accesorios' || chip === 'Conectividad') &&
    p.categoria !== chip
  ) {
    return false;
  }
  if (q.length > 0) {
    const termino = q.toLowerCase();
    const coincideNombre = p.nombre.toLowerCase().includes(termino);
    const coincideOferta = (p.oferta ?? '').toLowerCase().includes(termino);
    return coincideNombre || coincideOferta;
  }
  return true;
});

const chips = [
  { id: 'Todos', etiqueta: 'Todos' },
  { id: 'Starlink', etiqueta: '● Starlink' },
  { id: 'Celular', etiqueta: 'Celular' },
  { id: 'Accesorios', etiqueta: 'Accesorios' },
  { id: 'Conectividad', etiqueta: 'Conectividad' },
];

function urlChip(nuevoChip: string): string {
  const params = new URLSearchParams();
  if (nuevoChip !== 'Todos') {
    params.set('chip', nuevoChip);
  }
  if (q) {
    params.set('q', q);
  }
  const query = params.toString();
  return query ? `/?${query}` : '/';
}
---

<App titulo="Catálogo" seccion="catalogo">
  {errorParam === 'acceso_denegado' && (
    <div
      role="alert"
      class="mb-4 rounded-xl border border-amber-300 bg-amber-50 p-3 text-sm font-medium text-amber-900"
    >
      Acceso restringido: solo el Administrador puede entrar a Gestión.
    </div>
  )}

  <div class="mb-4 flex items-center justify-between gap-2">
    <div>
      <h1 class="text-xl font-bold text-slate-900">Catálogo de equipos</h1>
      <p class="text-xs text-slate-600">
        Consulta stock, compatibilidad Starlink y ofertas en mostrador
      </p>
    </div>
    <a
      href="/comprobantes/nuevo"
      class="inline-flex min-h-[44px] items-center rounded-xl bg-emerald-600 px-3.5 py-2 text-xs font-bold text-white shadow-xs hover:bg-emerald-700"
    >
      + Nueva venta
    </a>
  </div>

  <form method="GET" action="/" class="mb-3 flex gap-2">
    {chip !== 'Todos' && <input type="hidden" name="chip" value={chip} />}
    <input
      type="search"
      name="q"
      value={q}
      placeholder="Buscar modelo u oferta (ej. S24, Starlink)..."
      aria-label="Buscar producto"
      class="min-h-[44px] flex-1 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/20"
    />
    <button
      type="submit"
      class="min-h-[44px] rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800"
    >
      Buscar
    </button>
    {(q || chip !== 'Todos') && (
      <a
        href="/"
        class="inline-flex min-h-[44px] items-center rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100"
      >
        Limpiar
      </a>
    )}
  </form>

  <div class="mb-5 flex flex-wrap gap-2" role="group" aria-label="Filtrar por categoría">
    {chips.map((item) => {
      const activo = chip === item.id;
      return (
        <a
          href={urlChip(item.id)}
          class:list={[
            'inline-flex min-h-[44px] items-center rounded-xl border px-3.5 py-2 text-xs font-bold transition',
            activo
              ? 'border-emerald-600 bg-emerald-600 text-white shadow-xs'
              : 'border-slate-300 bg-white text-slate-700 hover:border-slate-400 hover:bg-slate-100',
          ]}
        >
          {item.etiqueta}
        </a>
      );
    })}
  </div>

  {productosFiltrados.length === 0 ? (
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center">
      <p class="text-sm font-semibold text-slate-700">
        No se encontraron productos con ese filtro.
      </p>
      <a
        href="/"
        class="mt-3 inline-flex min-h-[44px] items-center rounded-xl bg-slate-900 px-4 py-2 text-xs font-bold text-white"
      >
        Ver todo el catálogo
      </a>
    </div>
  ) : (
    <div class="grid grid-cols-1 gap-3">
      {productosFiltrados.map((producto) => (
        <ProductCard producto={producto} />
      ))}
    </div>
  )}
</App>
