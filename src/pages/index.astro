---
import Buscador from '../components/Buscador.astro';
import Cabecera from '../components/Cabecera.astro';
import ProductCard from '../components/ProductCard.astro';
import Vacio from '../components/Vacio.astro';
import App from '../layouts/App.astro';
import { leer, type Producto } from '../lib/api';

const q = (Astro.url.searchParams.get('q') ?? '').trim();
const chip = Astro.url.searchParams.get('chip') ?? 'Todos';

const filtros = new URLSearchParams({ q, chip: chip === 'Todos' ? '' : chip });
const productos = (await leer<Producto[]>(Astro.cookies, `/productos?${filtros}`)) ?? [];

const chips = ['Todos', 'Starlink', 'Celular', 'Accesorios', 'Conectividad'];

function urlChip(nuevo: string): string {
  const params = new URLSearchParams();
  if (nuevo !== 'Todos') {
    params.set('chip', nuevo);
  }
  if (q) {
    params.set('q', q);
  }
  return params.size ? `/?${params}` : '/';
}
---

<App titulo="Catálogo" seccion="catalogo">
  <Cabecera titulo="Catálogo" descripcion="Precios, stock y compatibilidad Starlink al instante.">
    <a href="/comprobantes/nuevo" class="btn btn-primary">Registrar venta</a>
  </Cabecera>

  <Buscador action="/" name="q" value={q} placeholder="Buscar modelo u oferta" etiqueta="Buscar producto">
    {chip !== 'Todos' && <input type="hidden" name="chip" value={chip} />}
  </Buscador>

  <div class="-mx-4 mt-4 flex gap-2 overflow-x-auto px-4 [scrollbar-width:none] sm:mx-0 sm:px-0" role="group" aria-label="Filtrar">
    {
      chips.map((item) => (
        <a
          href={urlChip(item)}
          aria-current={chip === item ? 'true' : undefined}
          class="inline-flex h-9 shrink-0 items-center rounded-full border border-stone-300 bg-white px-4 text-[14px] font-medium text-stone-700 transition-colors hover:border-stone-400 hover:text-ink aria-[current=true]:border-ink aria-[current=true]:bg-ink aria-[current=true]:text-white"
        >
          {item}
        </a>
      ))
    }
  </div>

  <p class="mb-3 mt-6 text-[14px] text-stone-500" aria-live="polite">
    {productos.length} {productos.length === 1 ? 'producto' : 'productos'}{q && ` para “${q}”`}
  </p>

  {
    productos.length === 0 ? (
      <Vacio mensaje="No hay productos con ese filtro.">
        <a href="/" class="btn btn-secondary">Ver todo el catálogo</a>
      </Vacio>
    ) : (
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {productos.map((producto) => <ProductCard producto={producto} />)}
      </div>
    )
  }
</App>
