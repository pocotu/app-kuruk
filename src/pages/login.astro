---
import { actions, isInputError } from 'astro:actions';
import App from '../layouts/App.astro';

const resultado = Astro.getActionResult(actions.login);
if (resultado && !resultado.error) {
  return Astro.redirect('/');
}

const erroresCampo =
  resultado?.error && isInputError(resultado.error) ? resultado.error.fields : {};
const errorGeneral =
  resultado?.error && !isInputError(resultado.error) ? resultado.error.message : null;
---

<App titulo="Iniciar sesión">
  <div class="mx-auto mt-6 max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="mb-6 text-center">
      <div class="mx-auto mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-500 text-2xl font-extrabold text-slate-950">
        K
      </div>
      <h1 class="text-xl font-bold text-slate-900">KURUK Mostrador</h1>
      <p class="mt-1 text-sm text-slate-600">
        Smartphones de gama alta y equipos Starlink · Tambopata
      </p>
    </div>

    {errorGeneral && (
      <div
        role="alert"
        class="mb-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm font-medium text-red-800"
      >
        {errorGeneral}
      </div>
    )}

    <form method="POST" action={actions.login} novalidate class="space-y-4">
      <div>
        <label for="email" class="block text-sm font-semibold text-slate-700">
          Correo electrónico <span class="text-red-600">*</span>
        </label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="carlos.vendedor@kuruk.pe"
          class="mt-1 block min-h-[44px] w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/20"
        />
        {erroresCampo.email && (
          <p class="mt-1 text-xs font-medium text-red-600">{erroresCampo.email[0]}</p>
        )}
      </div>

      <div>
        <label for="password" class="block text-sm font-semibold text-slate-700">
          Contraseña <span class="text-red-600">*</span>
        </label>
        <input
          id="password"
          name="password"
          type="password"
          required
          autocomplete="current-password"
          placeholder="••••••••"
          class="mt-1 block min-h-[44px] w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/20"
        />
        {erroresCampo.password && (
          <p class="mt-1 text-xs font-medium text-red-600">{erroresCampo.password[0]}</p>
        )}
      </div>

      <button
        type="submit"
        class="w-full min-h-[48px] rounded-xl bg-emerald-600 px-4 py-3 text-sm font-bold text-white shadow-sm hover:bg-emerald-700 active:bg-emerald-800"
      >
        Ingresar al mostrador
      </button>
    </form>

    <div class="mt-6 border-t border-slate-200 pt-4">
      <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">
        Acceso rápido de prueba
      </p>
      <div class="grid grid-cols-1 gap-2 text-xs">
        <button
          type="button"
          data-demo-email="carlos.vendedor@kuruk.pe"
          data-demo-pass="kuruk123"
          class="demo-login flex min-h-[44px] items-center justify-between rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-left hover:bg-slate-100"
        >
          <span>
            <strong class="text-slate-800">Carlos (Vendedor)</strong>
            <span class="block text-slate-500">carlos.vendedor@kuruk.pe · kuruk123</span>
          </span>
          <span class="rounded bg-slate-200 px-2 py-0.5 font-semibold text-slate-700">Usar</span>
        </button>

        <button
          type="button"
          data-demo-email="admin@kuruk.pe"
          data-demo-pass="admin123"
          class="demo-login flex min-h-[44px] items-center justify-between rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-left hover:bg-slate-100"
        >
          <span>
            <strong class="text-slate-800">Administrador KURUK</strong>
            <span class="block text-slate-500">admin@kuruk.pe · admin123</span>
          </span>
          <span class="rounded bg-slate-200 px-2 py-0.5 font-semibold text-slate-700">Usar</span>
        </button>

        <button
          type="button"
          data-demo-email="lucia.vendedor@kuruk.pe"
          data-demo-pass="kuruk123"
          class="demo-login flex min-h-[44px] items-center justify-between rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-left hover:bg-slate-100"
        >
          <span>
            <strong class="text-slate-800">Lucía (Vendedor 2)</strong>
            <span class="block text-slate-500">lucia.vendedor@kuruk.pe · kuruk123</span>
          </span>
          <span class="rounded bg-slate-200 px-2 py-0.5 font-semibold text-slate-700">Usar</span>
        </button>
      </div>
    </div>
  </div>

  <script>
    const botonesDemo = document.querySelectorAll<HTMLButtonElement>('.demo-login');
    const inputEmail = document.querySelector<HTMLInputElement>('#email');
    const inputPass = document.querySelector<HTMLInputElement>('#password');

    botonesDemo.forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (inputEmail && btn.dataset.demoEmail) {
          inputEmail.value = btn.dataset.demoEmail;
        }
        if (inputPass && btn.dataset.demoPass) {
          inputPass.value = btn.dataset.demoPass;
        }
      });
    });
  </script>
</App>
