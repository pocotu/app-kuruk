---
import Cabecera from '../../../components/Cabecera.astro';
import FormProducto from '../../../components/FormProducto.astro';
import App from '../../../layouts/App.astro';
import { api, avisar, cuerpoProducto, leerFormulario } from '../../../lib/api';

let errores: Record<string, string> = {};
let errorGeneral: string | null = null;
let form: Record<string, string> | null = null;

if (Astro.request.method === 'POST') {
  form = await leerFormulario(Astro.request);
  const r = await api(Astro.cookies, 'POST', '/productos', cuerpoProducto(form));
  if (r.ok) {
    avisar(Astro.cookies, 'Producto creado.');
    return Astro.redirect('/gestion');
  }
  errores = r.campos;
  errorGeneral = r.general;
}
---

<App titulo="Nuevo producto" seccion="gestion">
  <div class="mx-auto max-w-2xl">
    <Cabecera titulo="Nuevo producto" volver={{ href: '/gestion', texto: 'Gestión' }} />
    <FormProducto enviado={form} errores={errores} error={errorGeneral} boton="Crear producto" />
  </div>
</App>
