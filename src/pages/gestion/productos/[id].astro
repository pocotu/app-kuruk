---
import { actions, isInputError } from 'astro:actions';
import { db, eq, Productos } from 'astro:db';
import App from '../../../layouts/App.astro';
import { codigoProducto } from '../../../lib/formato';

const usuario = Astro.locals.user;
if (!usuario || usuario.rol !== 'Administrador') {
  return Astro.redirect('/?error=acceso_denegado');
}

const idParam = Number(Astro.params.id);
if (!Number.isInteger(idParam) || idParam <= 0) {
  return Astro.redirect('/gestion');
}

const resultado = Astro.getActionResult(actions.editarProducto);
if (resultado && !resultado.error) {
  return Astro.redirect('/gestion?mensaje=actualizado');
}

const filas = await db.select().from(Productos).where(eq(Productos.id, idParam));
const producto = filas[0];
if (!producto) {
  return Astro.redirect('/gestion');
}

const erroresCampo =
  resultado?.error && isInputError(resultado.error) ? resultado.error.fields : {};
const errorGeneral =
  resultado?.error && !isInputError(resultado.error) ? resultado.error.message : null;
---

<App titulo={`Editar ${codigoProducto(producto.id)}`} seccion="gestion">
  <div class="mb-4">
    <a
      href="/gestion"
      class="inline-flex min-h-[44px] items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-slate-900"
    >
      ← Volver a gestión
    </a>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
    <div class="flex items-center gap-2">
      <span class="rounded bg-slate-100 px-2 py-0.5 font-mono text-xs font-semibold text-slate-600">
        {codigoProducto(producto.id)}
      </span>
      <h1 class="text-xl font-bold text-slate-900">Editar producto</h1>
    </div>
    <p class="mt-1 text-xs text-slate-600">
      Actualiza precio, stock disponible, categoría u oferta vigente.
    </p>

    {errorGeneral && (
      <div
        role="alert"
        class="mt-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm font-medium text-red-800"
      >
        {errorGeneral}
      </div>
    )}

    <form method="POST" action={actions.editarProducto} novalidate class="mt-5 space-y-4">
      <input type="hidden" name="id" value={producto.id} />

      <div>
        <label for="nombre" class="block text-sm font-semibold text-slate-700">
          Nombre del equipo <span class="text-red-600">*</span>
        </label>
        <input
          id="nombre"
          name="nombre"
          type="text"
          required
          value={producto.nombre}
          class="mt-1 block min-h-[44px] w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/20"
        />
        {erroresCampo.nombre && (
          <p class="mt-1 text-xs font-semibold text-red-600">{erroresCampo.nombre[0]}</p>
        )}
      </div>

      <div>
        <label for="categoria" class="block text-sm font-semibold text-slate-700">
          Categoría <span class="text-red-600">*</span>
        </label>
        <select
          id="categoria"
          name="categoria"
          required
          class="mt-1 block min-h-[44px] w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/20"
        >
          <option value="Celular" selected={producto.categoria === 'Celular'}>
            Celular
          </option>
          <option value="Conectividad" selected={producto.categoria === 'Conectividad'}>
            Conectividad
          </option>
          <option value="Accesorios" selected={producto.categoria === 'Accesorios'}>
            Accesorios
          </option>
        </select>
        {erroresCampo.categoria && (
          <p class="mt-1 text-xs font-semibold text-red-600">
            {erroresCampo.categoria[0]}
          </p>
        )}
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label for="precio" class="block text-sm font-semibold text-slate-700">
            Precio en soles (S/) <span class="text-red-600">*</span>
          </label>
          <input
            id="precio"
            name="precio"
            type="number"
            min="1"
            step="0.01"
            required
            value={producto.precio}
            class="mt-1 block min-h-[44px] w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/20"
          />
          {erroresCampo.precio && (
            <p class="mt-1 text-xs font-semibold text-red-600">{erroresCampo.precio[0]}</p>
          )}
        </div>

        <div>
          <label for="stock" class="block text-sm font-semibold text-slate-700">
            Stock disponible <span class="text-red-600">*</span>
          </label>
          <input
            id="stock"
            name="stock"
            type="number"
            min="0"
            step="1"
            required
            value={producto.stock}
            class="mt-1 block min-h-[44px] w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/20"
          />
          {erroresCampo.stock && (
            <p class="mt-1 text-xs font-semibold text-red-600">{erroresCampo.stock[0]}</p>
          )}
        </div>
      </div>

      <div>
        <label for="oferta" class="block text-sm font-semibold text-slate-700">
          Oferta vigente (opcional)
        </label>
        <input
          id="oferta"
          name="oferta"
          type="text"
          value={producto.oferta ?? ''}
          placeholder="Ej. Case / Cargador gratis"
          class="mt-1 block min-h-[44px] w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/20"
        />
      </div>

      <div class="rounded-xl border border-slate-200 bg-slate-50 p-3.5">
        <label class="flex min-h-[44px] cursor-pointer items-center gap-3">
          <input
            type="checkbox"
            name="compatible_starlink"
            checked={producto.compatible_starlink}
            class="h-5 w-5 rounded border-slate-300 text-emerald-600 focus:ring-emerald-600"
          />
          <span class="text-sm font-semibold text-slate-800">
            Compatible con red satelital Starlink (muestra etiqueta verde)
          </span>
        </label>
      </div>

      <div class="flex gap-2.5 pt-2">
        <button
          type="submit"
          class="min-h-[48px] flex-1 rounded-xl bg-emerald-600 px-4 py-3 text-sm font-bold text-white shadow-xs hover:bg-emerald-700"
        >
          Guardar cambios
        </button>
        <a
          href="/gestion"
          class="inline-flex min-h-[48px] items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-100"
        >
          Cancelar
        </a>
      </div>
    </form>
  </div>
</App>
