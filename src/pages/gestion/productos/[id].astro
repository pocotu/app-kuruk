---
import Cabecera from '../../../components/Cabecera.astro';
import FormProducto from '../../../components/FormProducto.astro';
import App from '../../../layouts/App.astro';
import { api, avisar, cuerpoProducto, leer, leerFormulario, type Producto } from '../../../lib/api';
import { codigoProducto } from '../../../lib/formato';

const ruta = `/productos/${Astro.params.id}`;
let errores: Record<string, string> = {};
let errorGeneral: string | null = null;
let form: Record<string, string> | null = null;

if (Astro.request.method === 'POST') {
  form = await leerFormulario(Astro.request);
  const r = await api(Astro.cookies, 'PATCH', ruta, cuerpoProducto(form));
  if (r.ok) {
    avisar(Astro.cookies, 'Producto actualizado.');
    return Astro.redirect('/gestion');
  }
  errores = r.campos;
  errorGeneral = r.general;
}

const producto = await leer<Producto>(Astro.cookies, ruta);
if (!producto) {
  return Astro.redirect('/gestion');
}
---

<App titulo={`Editar ${producto.nombre}`} seccion="gestion">
  <div class="mx-auto max-w-2xl">
    <Cabecera titulo="Editar producto" descripcion={`${producto.nombre} · ${codigoProducto(producto.id)}`} volver={{ href: '/gestion', texto: 'Gestión' }} />
    <FormProducto enviado={form} producto={producto} errores={errores} error={errorGeneral} boton="Guardar cambios" />
  </div>
</App>
