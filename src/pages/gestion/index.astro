---
import Cabecera from '../../components/Cabecera.astro';
import Starlink from '../../components/Starlink.astro';
import Stock from '../../components/Stock.astro';
import App from '../../layouts/App.astro';
import { leer, type Producto } from '../../lib/api';
import { codigoProducto, formatearSoles } from '../../lib/formato';

const productos = (await leer<Producto[]>(Astro.cookies, '/productos')) ?? [];
---

<App titulo="Gestión" seccion="gestion">
  <Cabecera titulo="Gestión de productos">
    <a href="/gestion/productos/nuevo" class="btn btn-primary">Nuevo producto</a>
  </Cabecera>

  <ul class="card divide-y divide-stone-200 overflow-hidden">
    {
      productos.map((p) => (
        <li>
          <a href={`/gestion/productos/${p.id}`} class="fila" aria-label={`Editar ${p.nombre}`}>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <p class="text-[15px] font-medium">{p.nombre}</p>
                {p.compatible_starlink && <Starlink />}
              </div>
              <p class="mt-0.5 text-[13px] text-stone-500">
                {p.categoria} · <span class="font-mono">{codigoProducto(p.id)}</span>{p.oferta && ` · ${p.oferta}`}
              </p>
            </div>
            <div class="flex shrink-0 flex-col items-end gap-1">
              <span class="text-[15px] font-semibold tabular-nums">{formatearSoles(p.precio)}</span>
              <Stock producto={p} />
            </div>
            <svg class="size-5 shrink-0 text-stone-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M7.2 4.2a.75.75 0 0 1 1.06 0l5.27 5.27a.75.75 0 0 1 0 1.06L8.26 15.8a.75.75 0 1 1-1.06-1.06L11.94 10 7.2 5.26a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
</App>
